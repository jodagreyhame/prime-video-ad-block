{
  "manifest_version": 3,
  "name": "Prime Video Ad Block",
  "version": "1.0.0",
  "description": "Automatically mutes Prime Video ad breaks, unmutes the moment your show is back, and can alert you when it happens.",
  "homepage_url": "https://github.com/jodagreyhame/prime-video-ad-block",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://*.primevideo.com/*",
    "*://*.amazon.com/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.nl/*",
    "*://*.amazon.se/*",
    "*://*.amazon.pl/*",
    "*://*.amazon.com.be/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.com.mx/*",
    "*://*.amazon.com.br/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.in/*",
    "*://*.amazon.com.au/*",
    "*://*.amazon.sg/*",
    "*://*.amazon.ae/*",
    "*://*.amazon.sa/*",
    "*://*.amazon.eg/*",
    "*://*.amazon.com.tr/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.primevideo.com/*",
        "*://*.amazon.com/gp/video/*",
        "*://*.amazon.com/dp/*",
        "*://*.amazon.com/*/dp/*",
        "*://*.amazon.com/gp/product/*",
        "*://*.amazon.co.uk/gp/video/*",
        "*://*.amazon.co.uk/dp/*",
        "*://*.amazon.co.uk/*/dp/*",
        "*://*.amazon.co.uk/gp/product/*",
        "*://*.amazon.de/gp/video/*",
        "*://*.amazon.de/dp/*",
        "*://*.amazon.de/*/dp/*",
        "*://*.amazon.de/gp/product/*",
        "*://*.amazon.fr/gp/video/*",
        "*://*.amazon.fr/dp/*",
        "*://*.amazon.fr/*/dp/*",
        "*://*.amazon.fr/gp/product/*",
        "*://*.amazon.it/gp/video/*",
        "*://*.amazon.it/dp/*",
        "*://*.amazon.it/*/dp/*",
        "*://*.amazon.it/gp/product/*",
        "*://*.amazon.es/gp/video/*",
        "*://*.amazon.es/dp/*",
        "*://*.amazon.es/*/dp/*",
        "*://*.amazon.es/gp/product/*",
        "*://*.amazon.nl/gp/video/*",
        "*://*.amazon.nl/dp/*",
        "*://*.amazon.nl/*/dp/*",
        "*://*.amazon.nl/gp/product/*",
        "*://*.amazon.se/gp/video/*",
        "*://*.amazon.se/dp/*",
        "*://*.amazon.se/*/dp/*",
        "*://*.amazon.se/gp/product/*",
        "*://*.amazon.pl/gp/video/*",
        "*://*.amazon.pl/dp/*",
        "*://*.amazon.pl/*/dp/*",
        "*://*.amazon.pl/gp/product/*",
        "*://*.amazon.com.be/gp/video/*",
        "*://*.amazon.com.be/dp/*",
        "*://*.amazon.com.be/*/dp/*",
        "*://*.amazon.com.be/gp/product/*",
        "*://*.amazon.ca/gp/video/*",
        "*://*.amazon.ca/dp/*",
        "*://*.amazon.ca/*/dp/*",
        "*://*.amazon.ca/gp/product/*",
        "*://*.amazon.com.mx/gp/video/*",
        "*://*.amazon.com.mx/dp/*",
        "*://*.amazon.com.mx/*/dp/*",
        "*://*.amazon.com.mx/gp/product/*",
        "*://*.amazon.com.br/gp/video/*",
        "*://*.amazon.com.br/dp/*",
        "*://*.amazon.com.br/*/dp/*",
        "*://*.amazon.com.br/gp/product/*",
        "*://*.amazon.co.jp/gp/video/*",
        "*://*.amazon.co.jp/dp/*",
        "*://*.amazon.co.jp/*/dp/*",
        "*://*.amazon.co.jp/gp/product/*",
        "*://*.amazon.in/gp/video/*",
        "*://*.amazon.in/dp/*",
        "*://*.amazon.in/*/dp/*",
        "*://*.amazon.in/gp/product/*",
        "*://*.amazon.com.au/gp/video/*",
        "*://*.amazon.com.au/dp/*",
        "*://*.amazon.com.au/*/dp/*",
        "*://*.amazon.com.au/gp/product/*",
        "*://*.amazon.sg/gp/video/*",
        "*://*.amazon.sg/dp/*",
        "*://*.amazon.sg/*/dp/*",
        "*://*.amazon.sg/gp/product/*",
        "*://*.amazon.ae/gp/video/*",
        "*://*.amazon.ae/dp/*",
        "*://*.amazon.ae/*/dp/*",
        "*://*.amazon.ae/gp/product/*",
        "*://*.amazon.sa/gp/video/*",
        "*://*.amazon.sa/dp/*",
        "*://*.amazon.sa/*/dp/*",
        "*://*.amazon.sa/gp/product/*",
        "*://*.amazon.eg/gp/video/*",
        "*://*.amazon.eg/dp/*",
        "*://*.amazon.eg/*/dp/*",
        "*://*.amazon.eg/gp/product/*",
        "*://*.amazon.com.tr/gp/video/*",
        "*://*.amazon.com.tr/dp/*",
        "*://*.amazon.com.tr/*/dp/*",
        "*://*.amazon.com.tr/gp/product/*"
      ],
      "js": [
        "src/common/defaults.js",
        "src/common/state-machine.js",
        "src/content/detect.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Prime Video Ad Block",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
